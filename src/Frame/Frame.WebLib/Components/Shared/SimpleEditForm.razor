    // protected BaseEntityValidator<TEntity>? Validator
    // {
    //     get
    //     {
    //         if (_validator == null && _validatorProvider != null)
    //         {
    //             var validator = _validatorProvider.GetValidator<TEntity>();
    //             if (validator != null)
    //             {
    //                 _validator = validator as BaseEntityValidator<TEntity>;
    //             }
    //         }
    //         if (_validator == null)
    //         {
    //             _validator = new BaseEntityValidator<TEntity>();
    //         }
    //         return _validator;
    //     }
    // }

    #endregion

    #region ====================  Инициализация формы. ====================

    protected override async Task OnInitializedAsync()
    {
        _isAuthorized = await AuthHelpers.CheckAuthorized(_currentUserService, _logger, _snackBar); /*NavigationManager*/

        if(_compositeFormState != null || _entitiesListFormState != null)
        {
            // Форма находится под управлением CompositeForm или списка EntitiesListDetail
            // В этом случае кнопка "Закрыть" не должна быть видимой: окном управляет 
            // либо композитная форма, либо вместо закрытия окна будет возврат в список
            ShowCloseButton = false;
        }

        // Корректируем видимость кнопок сохранения с учетом прав доступа на TEntity
        if (_isAuthorized && _userCore != null)
        {
            if (_formObject != null && _formObject.Id > 0)
            {
                _canModify = _userCore.CanModify(_formObject);
                _canView = _userCore.CanView(_formObject);
            }
            else
            {
                _canModify = _userCore.CanModify<TEntity>();
                _canView = _userCore.CanView<TEntity>();
            }

            Result<List<string>> resR = _userCore.GetReadableAttrNames<TEntity>();
            if (resR.IsErrorOrNull)
            {
                _snackBar?.Add(resR.ErrorResult, Severity.Error);
                _canModify = false;
                _canView = false;
            }
            else
            {
                _readablePropNames = resR.Value!;
            }

            Result<List<string>> resM = _userCore.GetEditableAttrNames<TEntity>();
            if (resM.IsErrorOrNull)
            {
                _snackBar?.Add(resM.ErrorResult, Severity.Error);
                _canModify = false;
                _canView = false;
            }
            else
            {
                _editablePropNames = resM.Value!;
            }
            
            _showSaveButton = ShowSaveButton && _canModify;
            _showSaveAndCreate = _showSaveButton;
            
            await OnCanViewSet.InvokeAsync(_canView);
            await OnCanModifySet.InvokeAsync(_canModify);
        }
        //InitFormObject();
    }

    #endregion

    protected MarkupString BuildTitle()
    {
        string title = Title;

        if (DynamicTitle != null)
        {
            title = DynamicTitle(_formObject);
        }

        if (title.Length == 0 && _formObject != null)
        {
            title = _formObject.Description;
            if (title.Length == 0)
            {
                title = "...";
            }
        }

        return new MarkupString(title);
    }

    /// <summary>
    /// Текущая форма переводится в режим "есть изменения". Одновременно оповещается внешняя композитная форма (при наличии).
    /// </summary>
    public void SetDataChanged()
    {
        _dataChanged = true;

        if(_compositeFormState != null && _formObject != null && _formObject.Id > 0)
        {
            // Композитную форму моментально оповещаем только если это существующий объект, 
            // поскольку он уже отслеживается контекстом.
            // Про новый объект мы оповестим в момент добавления в репозиторий
            _compositeFormState.SetDirty(true);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Текущая форма переводится в режим "нет изменений".
    /// Внешняя композитная форма (при наличии) не оповещается: если вдруг она владеет другими формами или данными,
    /// изменения в этой дочке не должны привести к тому, чтобы вся более сложная форма перестала нуждаться в сохранении.
    /// </summary>
    public void SetDataUnchanged()
    {
        _dataChanged = false;
        StateHasChanged();
    }

    public async Task SaveAndCreateAsync()
    {
        bool bSaved = await SaveEntityAsync();
        if (bSaved)
        {
            _valFormObject = new TEntity();
            _dataChanged = false;
            StateHasChanged();
        }
    }

    public async Task SaveAsync()
    {
        bool bSaved = await SaveEntityAsync();
        if (bSaved)
        {
            StateHasChanged();
        }
    }

    protected async Task<bool> SaveEntityAsync()
    {
        bool bSaved = true;
        if (FormObjectRepository != null && _formObject != null)
        {
            Result res;
            if (_formObject.Id == 0)
            {
                res = await FormObjectRepository.AddAsync(_formObject);

                if(!res.IsError && _entitiesListFormState != null)
                {
                    // Отправляем в EntitiesList новый объект, он будет добавлен в список Entities для отображения.
                    _entitiesListFormState.NotifyNewEntityAdded(_formObject);
                }
            }
            else
            {
                res = await FormObjectRepository.UpdateAsync(_formObject);
            }

            if (res.IsError)
            {
                _snackBar?.Add($"Ошибка сохранения: {res.ErrorResult}", Severity.Error);
                bSaved = false;
            }
            else
            {
                // Сохранение в хранилище делаем только в том случае, если форма автономна и не принадлежит к CompositeForm
                // и если для нее не установлен режим работы OperateInMemory
                if (_compositeFormState == null && !OperateInMemory)
                {
                    Result resSaved = await FormObjectRepository.ObjectStorage.SaveChangesAsync();
                    if (resSaved.IsError)
                    {
                        _snackBar?.Add($"Ошибка сохранения в БД: {resSaved.ErrorResult}", Severity.Error);
                        bSaved = false;
                    }
                    else
                    {
                        _snackBar?.Add($"Успешно сохранено", Severity.Success);
                        _dataChanged = false;
                    }
                }
                else
                {
                    // Оповещаем корневую композитную форму что данные изменились, и еще не сохранены в хранилище.
                    _compositeFormState?.SetDirty(true);
                    // А у себя говорим что все, мы на своем уровне все что могли - сохранили.
                    _dataChanged = false;
                }
            }
        }
        else
        {
            _snackBar?.Add("Сохранение невозможно: отсутствует доступ к репозиторию", Severity.Warning);
            bSaved = false;
        }
        return bSaved;
    }

    public async Task CancelAsync()
    {
        // EntitiesListFormState?.NotifyFormCompleted();

        if (JSRuntime != null && CloseWindowOnCompleted)
        {
            await JSRuntime.InvokeVoidAsync("window.close");
        }
    }

    // Go back in browser using Javascript on a Razor Page
    private async Task GoBackAsync()
    {
        if (JSRuntime != null)
        {
            await JSRuntime.InvokeVoidAsync("history.back");
        }
    }

