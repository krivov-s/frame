    //[Inject] protected IAuthService? _authService { get; set; }
    [Inject] protected ISnackbar? _snackBar { get; set; }
    [Inject] protected IJSRuntime? JSRuntime { get; set; }
    [Inject] ILogger<TParentComponent>? _logger { get; set; }
