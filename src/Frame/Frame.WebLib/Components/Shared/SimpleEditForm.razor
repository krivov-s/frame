    /// Нужно чтобы сообщить <see cref="EntitiesListDetail{TEntity, TParentComponent}" /> результаты работы формы, добавлять новые объекты в список.
    /// </summary>
    [CascadingParameter] EntitiesListDetailFormState<TEntity>? _entitiesListFormState { get; set; }

    #region ========== Внешний вид ==========

    /// <summary>
