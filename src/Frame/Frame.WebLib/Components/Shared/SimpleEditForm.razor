    /// <summary>
    /// Список полей, которые будут выводиться как Disabled
    /// </summary>
    [Parameter] public List<Field<TEntity>> DisabledFields { get; set; } = [];  

    /// <summary>
    /// Список полей, которые не будут выводиться
    /// </summary>
    [Parameter] public List<Field<TEntity>> HiddenFields { get; set; } = [];  

    #endregion

    #region ========== Действия, события и делегаты ==========

    /// <summary>
    /// Сигнал о том, что объект был загружен из БД или создан. Если объект был передан через параметр Entity - Action не будет вызван.
    /// </summary>
    [Parameter] public Action<TEntity, IBaseRepository<TEntity>?>? EntityLoaded { get; set; }

    #endregion

    #region ========== Конфигурирование источника данных ==========

    /// <summary>
    /// Признак того, что все операции должны выполнятья в памяти, без сохранения в БД.
    /// При установке этого параметра вызов SaveChangesAsync не производится.
    /// </summary>
    [Parameter] public bool OperateInMemory { get; set; }

    // /// <summary>
    // /// Id объекта, для которого строится форма редактирования. Если задано, параметр Entity должен быть равен null
    // /// или Entity.Id == Id
    // /// </summary>
    // [Parameter] public int Id { get; set; }

    /// <summary>
    /// Экземпляр объекта, для которого строится форма редактирования. Если задан, то параметр Id должено быть равен 0
    /// или Entity.Id == Id
    /// </summary>
    [Parameter] public TEntity? Entity { get; set; }

    // /// <summary>
    // /// Репозиторий, из которого был прочитан объект, или в который должен быть сохранен объект после создания.
    // /// ObjectStorage для всех остальных RefEdit-ов будет взят из <see cref="Repository.ObjectStorage" />
    // /// </summary>
    // [Parameter] public IBaseRepository<TEntity>? Repository { get; set; }

    /// <summary>
    /// Конфигурирование секции Select запроса. Используется при чтении данных объекта по его id.
    /// <para>Внимание! Если задается - то полностью переопределяет ConfigureSelect, который был задан (если был задан) при регистрации репозитория</para>
    /// </summary>
    [Obsolete("Устаревший параметр! Необходимо заменить на ConfigureQuerySpecification")]
    [Parameter] public Func<IQueryable<TEntity>, IQueryable<TEntity>>? ConfigureSelect { get; set; }
    
    [Parameter] public Func<IQuerySpecification<TEntity>, IQuerySpecification<TEntity>>? ConfigureQuerySpecification { get; set; }

    #endregion

    #region ========== Чтение прав на тип/объект ==========
    
    /// <summary>
    /// Установка значения CanView - может ли текущий пользователь просматривать свойства объекта
    /// </summary>
    [Parameter] public EventCallback<bool> OnCanViewSet { get; set; }
    
    /// <summary>
    /// Установка значения CanModify - может ли текущий пользователь редактировать свойства объекта
    /// </summary>
    [Parameter] public EventCallback<bool> OnCanModifySet { get; set; }
        
    #endregion
    
    #endregion

    #region ==================== Внутренние настраиваемые параметры, с которым работает форма. ====================

    private IBaseRepository<TEntity>? _formRepository = null;
    private IObjectStorage? _formStorage = null;
    
    private bool _showSaveButton = false;
    private bool _showSaveAndCreate = false;

    /// <summary>
    /// Объект, с которым работает форма. Инициализируется параметром <see cref="Entity" /> или создается формой.
    /// </summary>
    private TEntity? _formObject 
    { 
        get
        {
            if(_valFormObject == null)
            {
                _valFormObject = Entity;
            }
            return _valFormObject;
        }
    }
    private TEntity? _valFormObject = null;

    /// <summary>
    /// Хранилище, с которым работает форма. Порядок определения
    /// <list type="number">
    /// <item>Переданное в форму каскадным параметром <see cref="_sharedObjectStorage" /> </item>
    /// <item>Полученное от каскадного параметра <see cref="_sharedRepository" /> </item>
    /// <item>Полученное через DI в случае, если ничего не было передано</item>
    /// </list>
    /// </summary>
    protected IObjectStorage? FormObjectStorage
    {
        get
        {
            if(_formStorage == null)
            {
                if (_sharedObjectStorage != null)
                {
                    _formStorage = _sharedObjectStorage;
                }
                else if (_sharedRepository != null)
                {
                    _formStorage = _sharedRepository.ObjectStorage;
                }
                else
                {
                    _snackBar?.Add("Ошибка конфигурирования: в SimpleEditForm не передан ни один каскадный параметер (SharedObjectStorage или SharedRepository)");
                }
                // else if(_objectStorageProvider != null)
                // {
                //     Result<IObjectStorage> res = _objectStorageProvider.GetObjectStorage();
                //     if (res.IsError || res.Value == null)
                //     {
                //         string strError = $"Не удалось получить ObjectStorage от IObjectStorageProvider: {res.ErrorResult}";
                //         _logger?.LogError(strError);
                //         _snackBar?.Add(strError, MudBlazor.Severity.Error);
                //     }
                //     else
                //     {
                //         _formStorage = res.Value;
                //     }
                // }
            }
            return _formStorage;
        }
        set => _formStorage = value;
    }

    /// <summary>
    /// Репозиторий, с которым работает форма. Порядок определения:
    /// <list type="number">
    /// <item>Переданное в форму каскадным параметром <see cref="_sharedRepository" /> </item>
    /// <item>Полученное от <see cref="FormObjectStorage" /> </item>
    /// </list>
    /// </summary>
    protected IBaseRepository<TEntity>? FormObjectRepository
    {
        get
        {
            if(_formRepository == null)
            {
                if (_sharedRepository != null)
                {
                    _formRepository = _sharedRepository;
                }
                else if (FormObjectStorage != null)
                {
                    Result<IBaseRepository<TEntity>> resRepo = FormObjectStorage.GetBaseRepository<TEntity>();
                    if (resRepo.IsError || resRepo.Value == null)
                    {
                        string strError = "Ошибка при получении репозитория из хранилища";
                        _logger?.LogError("{strError} : {ErrorResult}", strError, resRepo.ErrorResult);
                        _snackBar?.Add(strError, Severity.Error);
                    }
                    else
                    {
                        _formRepository = resRepo.Value;
                        
                        if (ConfigureSelect != null)
                        {
                            _formRepository.ConfigureSelect = ConfigureSelect;
                        }

                        if (ConfigureQuerySpecification != null)
                        {
                            _formRepository.ConfigureQuerySpecification = ConfigureQuerySpecification;
                        }

                    }
                }
            }
            return _formRepository;
        }
        set => _formRepository = value;
    }

    #endregion

    #region ==================== Внутренние служебные переменные формы ====================

    private bool _dataChanged = false;
    private bool _isAuthorized = false;
    private bool _isLoading = false;
    private bool _canView = false;
    private bool _canModify = false;
    private List<string> _readablePropNames = [];
    private List<string> _editablePropNames = [];

    // Валидацию не удалось заставить работать по-нормальному: контролам требуется наличие свойства "For"
    // Однако конструкция For="@(() => field.GetValueFromEntity(Entity, ""))" не прокатила, выдала ошибку в Runtime.
