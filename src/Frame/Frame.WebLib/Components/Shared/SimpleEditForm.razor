@typeparam TEntity where TEntity : BaseEntity, IBaseGenericEntity<TEntity>, new()
@typeparam TParentComponent where TParentComponent : class
@* @inherits EntitiesListDetailForm *@

@* @layout Frame.WebLib.Components.Layout.FormLayout
 *@

@using Frame.WebLib.Shared
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using Frame.Shared
@using Frame.App.Security
@using Frame.Domain.Entities.Core
@using Frame.App.IEntityRepositories
@using Frame.App.Cores
@using Frame.Domain
@using Frame.Domain.QuerySpec


<ErrorBoundary>
<ChildContent>
        @* Validation="@(Validator?.ValidateValue)" *@
    <MudForm Model="_formObject" FieldChanged="SetDataChanged">
        <MudCard>
            @if (_isAuthorized)
            {
                @if (_isLoading)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText>Идет загрузка...</MudText>
                }
                else if (_canView == false)
                {
                    <MudAlert Severity="Severity.Warning">Отсутствует право просмотра информации!</MudAlert>
                }
                else
                {
                    if (ShowTitle)
                    {
                        MarkupString mstrTitle = BuildTitle();
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="@TitleTypo">@mstrTitle</MudText>
                                <MudDivider />
                            </CardHeaderContent>
                        </MudCardHeader>
                    }
                    <MudCardContent>
                        @if (_formObject != null)
                        {
                            <CascadingValue Name="CanModify" Value="_canModify">
                            <CascadingValue Name="ReadableProps" Value="_readablePropNames">
                            <CascadingValue Name="EditableProps" Value="_editablePropNames">
                                @if (ChildContent == null)
                                {
                                    @foreach (var field in _formObject.GetFields())
                                    {
                                        if (HiddenFields.Contains(field))
                                        {
                                            // Если поле в списке скрытых полей - пропускаем его 
                                            continue;
                                        }
                                        if (_readablePropNames.Count > 0 && !_readablePropNames.Contains(field.Name))
                                        {
                                            // Задан список доступных для просмотра полей, а данного поля в нем нет - пропускаем 
                                            continue;
                                        }

                                        bool fieldIsReadOnly = _editablePropNames.Count > 0 && !_editablePropNames.Contains(field.Name);
                                        bool fieldInDisabledList = DisabledFields.Contains(field) || fieldIsReadOnly;
                                        
                                        if (field.FieldType == EntityFieldType.Ref)
                                        {
                                            <RefEditFactory TEntity="TEntity"
                                                            Disabled="!_canModify || fieldInDisabledList"
                                                            Field="field"
                                                            Entity="_formObject"
                                                            Variant="@FieldEditVariant"
                                                            ValueChanged="SetDataChanged"/>
                                        }
                                        else
                                        {
                                            <FieldEditFactory TEntity="TEntity"
                                                              Entity="_formObject"
                                                              Disabled="!_canModify || fieldInDisabledList"
                                                              Field="field"/>
                                        }
                                    }
                                }
                                else
                                {
                                    @ChildContent
                                }
                                    
                            </CascadingValue>
                            </CascadingValue>
                            </CascadingValue>
                        }
                    </MudCardContent>
                    <MudCardActions>
                        @if (_dataChanged)
                        {
                            bool bShowSaveButton = ShowSaveButton;
                            bool bShowSaveAndCreateButton = ShowSaveAndCreateButton;
                            string strSaveButtonText = "Сохранить";
                            // Если мы в составе композитной формы, то кнопки добавления можно показывать только в случае нового объекта,
                            // поскольку до момента добавления в репозиторий основной форме пофиг: закроем и ничего не сохранится.
                            // А если объект уже в контексте - то в любом случае мы его уже правим, засветится основная кнопка композитной формы
                            if (_compositeFormState != null)
                            {
                                bShowSaveAndCreateButton = false;
                                if (_formObject == null || _formObject.Id != 0)
                                {
                                    // В составе композитной формы для существующего объекта кнопка Save бессмысленна: 
                                    // изменения сразу происходят в объекте, котоорый уже в ObjectStorage и будет сохранен 
                                    // в случае сохранения CompositeForm
                                    bShowSaveButton = false;
                                }
                                else if(_formObject != null && _formObject.Id == 0)
                                {
                                    strSaveButtonText = "Проверить и приготовить к сохранению";
                                }
                            }
                            if(bShowSaveButton)
                            {
                                <MudTooltip Text="Сохранить сделанные изменения" Arrow="true" Color="Color.Default">
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveAsync" class="ma-1">@strSaveButtonText</MudButton>
                                </MudTooltip>
                            }
                            if (bShowSaveAndCreateButton)
                            {
                                <MudTooltip Text="Сохранить сделанные изменения и создать новый документ" Arrow="true" Color="Color.Default">
                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SaveAndCreateAsync" class="ma-1">Сохранить и создать</MudButton>
                                </MudTooltip>
                            }
                        }
                        @if(ShowCloseButton)
                        {
                            <MudTooltip Text="Закрыть окно" Arrow="true" Color="Color.Default">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CancelAsync" class="ma-1">Закрыть</MudButton>
                            </MudTooltip>
                        }
                    </MudCardActions>
                }
            }
            else
            {
                <MudAlert Severity="Severity.Error">Ошибка авторизации!</MudAlert>
            }
        </MudCard>
    </MudForm>
</ChildContent>
<ErrorContent Context="ctx">
    <p class="errorUI">😈 Какая-то хрень </p>
</ErrorContent>
</ErrorBoundary>


@code {
    #region ==================== Внешние сервисы ====================
