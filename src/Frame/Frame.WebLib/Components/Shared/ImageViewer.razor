@using System.IO
@using Microsoft.Extensions.Caching.Memory

@if (_imageData.Length > 0)
{
    <div class="image-container">
        <MudImage Src="@_imageData"
                  Alt="@ImageName"
                  ObjectFit="ObjectFit.Contain"
                  Style="width: 100%; height: 100%;"
                  Class="mud-height-full" />
    </div>
}
else
{
    <MudProgressCircular Color="Color.Secondary" Size="Size.Small" />
}

@code {
    [Inject] IMemoryCache? _cache { get; set; }
    [Inject] ISnackbar? _snackBar { get; set; }
    
    [Parameter] public string ImageName { get; set; } = "";
    [Parameter] public string FileDocumentKeyInMemoryCache { get; set; } = "";

    private string _imageData = "";
    private string _fileDocumentKeyInMemoryCache = "";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        
        if(_cache == null) return;
        if (FileDocumentKeyInMemoryCache == _fileDocumentKeyInMemoryCache && _imageData.Length > 0) return;
        
        _imageData = "";
        if (_cache!.TryGetValue(FileDocumentKeyInMemoryCache, out byte[]? fileContent))
        {
            // Картинка в кэше найдена. Читаем, конвертируем и отображаем.
            if (fileContent != null)
            {
                _fileDocumentKeyInMemoryCache = FileDocumentKeyInMemoryCache;
                _imageData = $"data:image/jpeg;base64,{Convert.ToBase64String(fileContent)}";
            }
            else
            {
                _snackBar?.Add($"При чтении из кэша картинки с ключом {FileDocumentKeyInMemoryCache} вернулся null!", Severity.Error);
            }
        }
        else
        {
            // Картинка в кэше не найдена. Ошибка.
            _snackBar?.Add($"Картинка {ImageName} не найдена!", Severity.Error);
        }
    }

    private string ConvertStreamToBase64(MemoryStream stream)
    {
        byte[] bytes = stream.ToArray();
        return Convert.ToBase64String(bytes);
    }
}