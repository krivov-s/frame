@using Frame.App.IEntityRepositories
@using Frame.Domain.Entities.Core

@typeparam TMainEntity where TMainEntity: BaseEntity
@typeparam TSelectEntity where TSelectEntity: BaseEntity, IBaseGenericEntity<TSelectEntity>, new()
@typeparam TLinkEntity where TLinkEntity: BaseEntity, IBaseGenericEntity<TLinkEntity>, new()

@if (_configErrors.Length > 0)
{
    <MudAlert Severity="Severity.Error">@_configErrors</MudAlert>
    @* Text="@GetMultiSelectionText()" *@
}
else
{
    <MudSelect T="TSelectEntity"
               Label="@Label"
               Disabled="@Disabled"
               MultiSelection="true"
               SelectedValues="@_selectedEntities"
               Text="@GetMultiSelectionText()" 
               SelectedValuesChanged="@OnSelectedValuesChanged">
        @if (_availableEntities != null)
        {
            foreach (var item in _availableEntities)
            {
                <MudSelectItem Value="@item">
                    @item.Description
                </MudSelectItem>
            }
        }
    </MudSelect>
}

