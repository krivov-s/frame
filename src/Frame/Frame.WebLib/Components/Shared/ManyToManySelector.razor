    private void InitSelectedEntities()
    {
        if (ExistingLinks != null)
        {
            _selectedEntities = [];
            if (GetSelectEntityFunc != null)
            {
                foreach (var link in ExistingLinks)
                {
                    var selectEntity = GetSelectEntityFunc(link);
                    if (selectEntity != null)
                    {
                        _selectedEntities.Add(selectEntity);
                    }
                }
            }
        }
    }

    private bool CheckParams()
    {
        if (MainEntity == null)
        {
            _configErrors += $"Не задан параметр {nameof(MainEntity)}! ";
            return false;
        }

        if (GetSelectEntityFunc == null)
        {
            _configErrors += $"Не задан параметр {nameof(GetSelectEntityFunc)}! ";
            return false;
        }

        if (CreateLinkEntityFunc == null)
        {
            _configErrors += $"Не задан параметр {nameof(CreateLinkEntityFunc)}! ";
            return false;
        }
            
        if (ExistingLinks == null)
        {
            _configErrors += $"Не задан параметр {nameof(ExistingLinks)}! ";
            return false;
        }

        return true;
    }

    private int GetLinkedEntityId(TLinkEntity linkEntity)
    {
        // Этот метод должен быть переопределен через лямбду при использовании
        throw new NotImplementedException(
            "Необходимо задать делегат для получения ID связанной сущности"
        );
    }

    private void OnSelectedValuesChanged(IEnumerable<TSelectEntity?>? selectedValues)
    {
        if (selectedValues == null || ExistingLinks == null || 
            CreateLinkEntityFunc == null || MainEntity == null || GetSelectEntityFunc == null)
        {
            return;
        }
        
        var currentSelectedSet = new List<TSelectEntity?>(selectedValues);

        _selectedEntities = _selectedEntities ?? [];
        
        // Сущности, которые были удалены
        var removedEntities = _selectedEntities.Except(currentSelectedSet).ToList();
        var addedEntities = currentSelectedSet.Except(_selectedEntities).ToList();

        // Обновление списка связей
        foreach (var removedEntity in removedEntities)
        {
            if (removedEntity != null)
            {
                var linkToRemove = ExistingLinks
                    .FirstOrDefault(link => GetSelectEntityFunc(link).Id == removedEntity.Id);
            
                if (linkToRemove != null)
                {
                    ExistingLinks.Remove(linkToRemove);
                }
            }
        }

        foreach (var addedEntity in addedEntities)
        {
            if (addedEntity != null)
            {
                ExistingLinks.Add(CreateLinkEntityFunc(MainEntity, addedEntity));
            }
        }

        // Обновление текущего состояния
        InitSelectedEntities();

        // Вызов обработчика для уведомления родительского компонента
        OnLinksUpdated?.Invoke(ExistingLinks);
    }    
