@* @rendermode @(new InteractiveServerRenderMode(false)) *@
@* *@
@* @using Frame.App.FileRepositories *@
@* @using Frame.Shared *@
@* @using Microsoft.AspNetCore.Components.Web *@
@* @using Microsoft.Extensions.Logging *@
@* @using Frame.Domain.Entities.Core.FileDocuments *@
@* *@
@* @if(_isLoading) *@
@* { *@
@*     <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/> *@
@* } *@
@* else *@
@* { *@
@*     if (_imageDataList.Count > 0) *@
@*     { *@
@*         <MudTabs Position="Position.Left" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6"> *@
@*             @{ *@
@*                 foreach (KeyValuePair<string, byte[]> kvp in _imageDataList) *@
@*                 { *@
@*                     <MudTabPanel Text="@kvp.Key"> *@
@*                         <div class="d-flex justify-center align-center" style="height: calc(100vh - 200px);"> *@
@*                             <ImageViewer ImageName="@kvp.Key" FileDocumentKeyInMemoryCache="@kvp.Value"></ImageViewer> *@
@*                         </div> *@
@*                     </MudTabPanel> *@
@*                 } *@
@*             } *@
@*         </MudTabs> *@
@*     } *@
@*     else *@
@*     { *@
@*         <MudText>Картинки для просмотра отсутствуют</MudText> *@
@*     } *@
@* } *@
@* *@
@* @code { *@
@*     [Inject] IFilesRepository? _filesRepository { get; set; } *@
@*     [Inject] ISnackbar? _snackBar { get; set; } *@
@*     [Inject] ILogger<CF_FileDocumentsPreview>? _logger { get; set; } *@
@* *@
@*     [Parameter] public List<FileDocument>? Items { get; set; } *@
@* *@
@*     private Dictionary<string, byte[]> _imageDataList = []; *@
@*     private bool _isLoading; *@
@* *@
@*     protected override async Task OnInitializedAsync() *@
@*     { *@
@*         if (Items != null && _filesRepository != null && _imageDataList.Count == 0) *@
@*         { *@
@*             try *@
@*             { *@
@*                 _isLoading = true; *@
@*                 await LoadAllImagesAsync(); *@
@*             } *@
@*             finally *@
@*             { *@
@*                 _isLoading = false; *@
@*                 StateHasChanged(); *@
@*             } *@
@*         } *@
@*     } *@
@* *@
@*     private async Task LoadAllImagesAsync() *@
@*     { *@
@*         if (_filesRepository == null || Items == null) *@
@*         { *@
@*             return; *@
@*         } *@
@* *@
@*         // Создаем список задач для параллельной загрузки *@
@*         int num = 0; *@
@*         object lockWrite = new(); *@
@*         var loadTasks = Items.Select(async fd => *@
@*         { *@
@*             try *@
@*             { *@
@*                 if (fd.IsImage() && fd.FileKey is { Length: > 0 }) *@
@*                 { *@
@*                     Result<byte[]> resFileData = await _filesRepository.GetFileAsync(fd.FileKey); *@
@*                     if (resFileData.IsError || resFileData.Value == null) *@
@*                     { *@
@*                         string err = $"Ошибка чтения из хранилища файла по ключу {fd.FileKey} : {resFileData.ErrorResult}"; *@
@*                         _logger?.LogError("{err}", err); *@
@*                         _snackBar?.Add(err, Severity.Error); *@
@*                     } *@
@*                     else *@
@*                     { *@
@*                         // Защита от одновременной записи данных в List *@
@*                         lock (lockWrite) *@
@*                         { *@
@*                             num++; *@
@*                             _imageDataList.Add($"{num:D2}. {fd.DocumentName}", resFileData.Value); *@
@*                         } *@
@*                     } *@
@*                 } *@
@*             } *@
@*             catch (Exception ex) *@
@*             { *@
@*                 string err = $"Исключение при чтении из хранилища: {ex.Message}"; *@
@*                 _logger?.LogError(ex, "{err}", err); *@
@*                 _snackBar?.Add(err, Severity.Error); *@
@*             } *@
@*         }); *@
@* *@
@*         // Ждем завершения загрузки всех изображений *@
@*         await Task.WhenAll(loadTasks); *@
@*     } *@
@* } *@
