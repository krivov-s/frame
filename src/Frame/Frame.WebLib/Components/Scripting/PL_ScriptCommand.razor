    private async Task ExecuteScriptCommandAsync(string strCommand, HashSet<ScriptCommand> commands, IBaseRepository<ScriptCommand> repository)
    {
        if (_scriptCore != null)
        {
            if (commands.Count != 1)
            {
                _snackBar?.Add("Запуск на выполнение разрешен только для одной команды", Severity.Error);
            }
            else
            {
                ScriptCommand? cmd = commands.FirstOrDefault();
                if (cmd != null && _dialogService != null && _scriptCore != null)
                {
                    await Helpers.ExecuteScriptCommandAsync<ScriptCommand>(cmd, [], repository.ObjectStorage,
                        _dialogService, _scriptCore, _logger, _snackBar);
                }
            }
        }
    }

