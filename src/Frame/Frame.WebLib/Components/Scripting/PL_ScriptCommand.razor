<MudGrid>
    <MudItem xs="12" sm="12">
        <EntitiesListDetail TEntity="ScriptCommand"
                            TParentComponent="PL_ScriptCommand"
                            Title="Список скрипт-операций"
                            Operations="Commands"
                            ConfigureQuerySpecification="spec => 
                                spec.Include(x => x.ScriptCommandType)
                                    .Include(x => x.ScriptCommandGroups)
                                        .ThenInclude(g => g.ScriptCommandGroup)
                                    .Build()"
                            AddNewEntityUri="@strAddNewUri"
                            EditEntityUri="@strEditUri"
                            EditMode="EntitiesListEditMode.FormContent">
            <GridContent>
                <PropertyColumn T="@ScriptCommand" TProperty="@string" Property="x => x.ScriptName" Title="@ScriptCommand.Meta.ScriptName.HumanName" />
                <PropertyColumn T="@ScriptCommand" 
                                TProperty="@string" 
                                Property="x => (x.ScriptCommandType != null) ? x.ScriptCommandType.Name : string.Empty" 
                                Title="@ScriptCommand.Meta.ScriptCommandType.HumanName" />
                <PropertyColumn T="@ScriptCommand" TProperty="@string" Property="x => Enum.GetName<ECodeType>(x.CodeType)" Title="@ScriptCommand.Meta.CodeType.HumanName" />
                <PropertyColumn T="@ScriptCommand" TProperty="@string" Property="x => Enum.GetName<EThreadType>(x.ThreadType)" Title="@ScriptCommand.Meta.ThreadType.HumanName" />
                <PropertyColumn T="@ScriptCommand" TProperty="@string" Property="x => x.EntityTypeName" Title="@ScriptCommand.Meta.EntityTypeName.HumanName" />
                <PropertyColumn T="@ScriptCommand" TProperty="@string" Property="x => x.ScriptCommandGroupNames" Title="@ScriptCommand.Meta.ScriptCommandGroupNames.HumanName" />
            </GridContent>

            <FormContent>
                <CF_ScriptCommand FormObject="context" />
            </FormContent>

        </EntitiesListDetail>
    </MudItem>
